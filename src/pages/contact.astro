---
import Base from "../layouts/Base.astro";
import { EMAIL, GITHUB, LINKEDIN, LOCATION, RESUME } from "../data/site";
---
<Base
  title="Contact | Mohammed Riyazuddin"
  description="Hiring for a Support Engineer or Customer Success Engineer? Email is the fastest way to reach Mohammed Riyazuddin."
  path="/contact"
  ogKey="contact"
  active="contact"
  dark
>
  <main class="wrap contact">
    <h1>Open a ticket with me.</h1>
    <p class="intro">Hiring for a Support Engineer or Customer Success Engineer? Email is the fastest way to reach me.</p>
    <a class="contact-mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <div class="contact-links">
      <a href={LINKEDIN}>LinkedIn</a>
      <a href={GITHUB}>GitHub</a>
      <a href={RESUME}>Resume (PDF)</a>
    </div>
    <p class="where">Based in {LOCATION}</p>
  </main>
</Base>
