---
import Base from "../layouts/Base.astro";
import { experience, sidebar } from "../data/site";
---
<Base
  title="About | Mohammed Riyazuddin"
  description="Close to two decades in support: leading support teams at Deloitte and Teradata, then almost 7 years in support engineering, most of it as a Happiness Engineer at Automattic."
  path="/about"
  ogKey="about"
  active="about"
>
  <main class="wrap page">
    <h1 class="page-title">About</h1>
    <p class="about-lead">I've spent close to two decades in support. I led support teams at Deloitte and Teradata, responsible for support operations, including hiring, coaching and performance management. Then I spent almost 7 years in support engineering, most of it at Automattic, where I also hired, led trial candidates and ran trainings. I'm open to Support Engineer, Support Lead and Support Manager roles, where I can stay close to customers while helping a team do its best work.</p>
    <div class="about-cols">
      <section class="about-main">
        <h2>Experience</h2>
        {experience.map((job) => (
          <article class="job">
            <div class="when">{job.when}</div>
            <h3>{job.role}</h3>
            <p>{job.text}</p>
          </article>
        ))}
      </section>
      <aside class="about-side">
        {sidebar.map((s) => <><h2>{s.title}</h2><p>{s.text}</p></>)}
      </aside>
    </div>
  </main>
</Base>
