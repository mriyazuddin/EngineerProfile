---
import Base from "../layouts/Base.astro";
import { experience, sidebar } from "../data/site";
---
<Base
  title="About | Mohammed Riyazuddin"
  description="A servant leader focused on operational excellence, with close to two decades in support: leading support teams at Deloitte, Teradata and ESW Capital, then almost 7 years in support engineering, most of it as a Happiness Engineer at Automattic."
  path="/about"
  ogKey="about"
  active="about"
>
  <main class="wrap page">
    <h1 class="page-title">About</h1>
    <p class="about-lead">I've spent close to two decades in support. For almost 7 years I worked in hands-on support engineering, most of it at Automattic, where I also hired, led trial candidates and ran trainings. Before that, I led support teams at Deloitte, Teradata and ESW Capital, responsible for support operations, including hiring, coaching and performance management. I believe in servant leadership, and I keep improving how the team works, one process at a time. I'm open to Technical Support Engineer and Support Lead roles, where I can stay close to customers while helping a team do its best work. Open to remote, hybrid or on-site roles, and to relocating.</p>
    <div class="about-cols">
      <section class="about-main">
        <h2>Experience</h2>
        {experience.map((job) => (
          <article class="job">
            <div class="when">{job.when}</div>
            <h3>{job.role}</h3>
            <p>{job.text}</p>
          </article>
        ))}
      </section>
      <aside class="about-side">
        {sidebar.map((s) => <><h2>{s.title}</h2><p>{s.text}</p></>)}
      </aside>
    </div>
  </main>
</Base>
