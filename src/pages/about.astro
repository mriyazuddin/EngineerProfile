---
import Base from "../layouts/Base.astro";
import { experience, sidebar } from "../data/site";
---
<Base
  title="About | Mohammed Riyazuddin"
  description="Almost 7 years in the WordPress ecosystem, with hands-on technical support across WooCommerce, DNS and SQL, including as a Happiness Engineer at Automattic."
  path="/about"
  ogKey="about"
  active="about"
>
  <main class="wrap page">
    <h1 class="page-title">About</h1>
    <p class="about-lead">I help people build and troubleshoot websites, simplify complex technical issues, and write documentation that saves the next person from opening a ticket. I'm looking for hands-on roles such as Support Engineer and Customer Success Engineer.</p>
    <div class="about-cols">
      <section class="about-main">
        <h2>Experience</h2>
        {experience.map((job) => (
          <article class="job">
            <div class="when">{job.when}</div>
            <h3>{job.role}</h3>
            <p>{job.text}</p>
          </article>
        ))}
      </section>
      <aside class="about-side">
        {sidebar.map((s) => <><h2>{s.title}</h2><p>{s.text}</p></>)}
      </aside>
    </div>
  </main>
</Base>
