---
import Base from "../layouts/Base.astro";
import { LINKEDIN, LOCATION, NAME, RESUME, debugAreas, leadershipAreas, projects, series, trackRecord } from "../data/site";
import { allPosts, postPath } from "../lib/posts";

const posts = await allPosts();
const selected = projects.slice(0, 2);
const leadershipPost = posts.find((p) => p.data.series === "leadership");
const seriesCards = (["sql", "wordpress"] as const).map((key) => {
  const latest = posts.find((p) => p.data.series === key);
  return {
    name: series[key].name,
    text: latest ? latest.data.title : "Follow along on LinkedIn",
    href: latest ? postPath(latest) : LINKEDIN,
  };
});
---
<Base
  title="Mohammed Riyazuddin | Technical Support Leader"
  description="Technical support leader in Hyderabad, India, with close to two decades in support. Led support teams at Deloitte and Teradata. Open to Support Engineer, Support Lead and Support Manager roles."
  path="/"
  ogKey="home"
  type="profile"
>
  <header class="wrap hero">
    <div class="hero-copy">
      <p class="status">status: open to Support Engineer, Support Lead and Support Manager roles</p>
      <h1>I lead support teams, and I still find out why it broke.</h1>
      <p class="lead">I'm Mohammed Riyazuddin, a technical support leader in Hyderabad, India. I've spent close to two decades in support: leading support teams at Deloitte and Teradata, then almost 7 years in support engineering, most of it at Automattic. I still enjoy debugging a broken checkout as much as building the team that handles it.</p>
      <div class="actions">
        <a class="btn btn-primary" href={RESUME}>Download resume</a>
        <a class="btn btn-outline" href="/about">See my experience</a>
      </div>
    </div>
    <div class="console">
      <div class="console-title">track_record.sql</div>
      <div class="console-body">
        <div><span class="kw">SELECT</span> metric, result</div>
        <div><span class="kw">FROM</span> support_career;</div>
        <table>
          <tbody>
            {trackRecord.map(([metric, result]) => <tr><td>{metric}</td><td>{result}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </header>

  <section class="wrap section">
    <h2>How I lead support teams</h2>
    <div class="grid-4">
      {leadershipAreas.map((a) => <div class="area"><h3>{a.title}</h3><p>{a.text}</p></div>)}
    </div>
    {leadershipPost && <p class="lead-more">From the leadership series: <a href={postPath(leadershipPost)}>{leadershipPost.data.title}</a></p>}
  </section>

  <section class="band">
    <div class="wrap section">
      <h2>What I still debug myself</h2>
      <div class="grid-4">
        {debugAreas.map((a) => <div class="area"><h3>{a.title}</h3><p>{a.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>Selected work</h2><a href="/work">All projects</a></div>
    <div class="cards">
      {selected.map((p) => (
        <a class="card" href="/work">
          <img src={p.img} alt={`${p.title} storefront`} loading="lazy" />
          <div class="card-body"><h3>{p.title}</h3><p>{p.summary}</p></div>
        </a>
      ))}
    </div>
  </section>

  <section class="learn">
    <div class="wrap section">
      <h2>Learn with me, one post a day</h2>
      <p class="sub">Two 60-post series for complete beginners.</p>
      <div class="series-grid">
        {seriesCards.map((c) => <a class="series-card" href={c.href}><div>{c.name}</div><div>{c.text}</div></a>)}
      </div>
    </div>
  </section>

  <footer class="wrap site-footer">
    <span>{NAME} · {LOCATION}</span>
    <a href={LINKEDIN}>LinkedIn</a>
  </footer>
</Base>
