---
// Review copy of the proposed new homepage (design B).
// Not linked from anywhere, not in the sitemap, and marked noindex.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import { EMAIL, GITHUB, LINKEDIN, LOCATION, NAME, RESUME, projects, series } from "../data/site";
import { allPosts, postPath } from "../lib/posts";

const posts = await allPosts();
const selected = projects.slice(0, 2);
const seriesCards = (["sql", "wordpress"] as const).map((key) => {
  const latest = posts.find((p) => p.data.series === key);
  return {
    name: series[key].name,
    text: latest ? latest.data.title : "Follow along on LinkedIn",
    href: latest ? postPath(latest) : LINKEDIN,
  };
});

const stats = [
  ["21", "APAC support roles recruited for at Automattic"],
  ["23%", "lower average handle time at Deloitte"],
  ["90%+", "customer satisfaction at Automattic"],
  ["100+", "support docs revamped"],
];
const strengths = [
  ["Leading support teams", "Managed L1 and L2 support engineers at Teradata and led a service desk team at Deloitte."],
  ["Hiring and training", "Six months on an APAC recruitment rotation at Automattic, and ran trainings there."],
  ["Process and documentation", "Workflow coaching and a knowledge base overhaul at Deloitte. Revamped over 100 support docs at Automattic."],
  ["Hands-on troubleshooting", "WordPress, WooCommerce, DNS, email and payments. I can still take the hard ticket myself."],
  ["Data and tools", "SQL queries, WP-CLI, browser DevTools, Zendesk, GitHub and Jira."],
];
const roles = [
  ["Dec 2025 to present", "Technical Support Engineer, Freelance", "WordPress and WooCommerce builds and fixes for small businesses."],
  ["Jun 2019 to Apr 2025", "Happiness Engineer, Automattic", "WordPress.com and WooCommerce support by email and live chat, using SQL to troubleshoot: 500+ tickets a month at 90%+ CSAT. Spent six months on an APAC recruitment rotation and ran trainings."],
  ["May 2018 to Apr 2019", "IT Support, Freelance", "On-site IT support for small businesses."],
  ["Sep 2016 to Apr 2018", "Senior Manager, Teradata", "Managed the L1 and L2 support engineers for Teradata products."],
  ["Aug 2005 to Sep 2016", "Manager, Service Desk, Deloitte", "Started as a front-line IT support analyst and went on to lead a team. Workflow coaching and a knowledge base overhaul cut average handle time from 17 to 13 minutes, about 23%."],
];
const services = [
  ["New sites and stores", "WordPress or WooCommerce set up end to end: theme, products, payments, shipping and tax."],
  ["Fixes and troubleshooting", "Plugin conflicts, broken layouts, failed payments, DNS and email problems. I find the cause, then fix it."],
  ["Ongoing maintenance", "Updates, backups and small changes each month, and someone to ask when something looks off."],
  ["Support docs and setup", "Help articles, saved replies and training, so your team answers customers faster."],
];
const projectMail = `mailto:${EMAIL}?subject=${encodeURIComponent("Project enquiry")}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{NAME} | Technical Support Lead</title>
    <meta name="description" content="Design preview of the new riyaz.blog homepage." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <nav class="nav" aria-label="Main">
      <a class="brand" href="#top">Riyaz<span>.</span></a>
      <div class="nav-links">
        <a href="/about">About</a>
        <a href="/work">Work</a>
        <a href="#services">Services</a>
        <a href="/blog">Blog</a>
        <a class="pill-dark" href={RESUME}>Resume</a>
      </div>
    </nav>

    <header id="top" class="wrap hero">
      <p class="status"><span aria-hidden="true"></span>Open to Technical Support Lead roles</p>
      <h1>I lead support teams that find out why it broke, fix it, and <span class="mark">write it down.</span></h1>
      <div class="hero-row">
        <p class="lead">I'm {NAME}, a technical support leader in {LOCATION}. I managed support teams at Teradata and Deloitte, then spent nearly six years at Automattic supporting WordPress.com and WooCommerce customers, recruiting for APAC support roles and running trainings.</p>
        <div class="actions">
          <a class="btn btn-blue" href={RESUME}>Download resume</a>
          <a class="btn btn-line" href="#experience">See my experience</a>
        </div>
      </div>
      <p class="aside">Need help with a WordPress site? <a href="#services">I also take freelance projects</a></p>
    </header>

    <section class="wrap">
      <div class="stats">
        {stats.map(([n, label]) => <div><p class="num">{n}</p><p class="num-label">{label}</p></div>)}
      </div>
    </section>

    <section class="grey">
      <div class="wrap section split">
        <div class="split-head">
          <h2>What I'm good at</h2>
          <p class="sub">Leading the people who solve customer problems, and still able to solve them myself.</p>
        </div>
        <div class="rows">
          {strengths.map(([title, text]) => <div class="row"><h3>{title}</h3><p>{text}</p></div>)}
        </div>
      </div>
    </section>

    <section id="experience" class="wrap section">
      <div class="section-head"><h2>Experience</h2><a href="/about">Full story</a></div>
      <div class="roles">
        {roles.map(([when, role, text]) => <div class="role"><p class="when">{when}</p><h3>{role}</h3><p>{text}</p></div>)}
      </div>
    </section>

    <section class="wrap section tight-top">
      <div class="section-head"><h2>Selected work</h2><a href="/work">All projects</a></div>
      <div class="cases">
        {selected.map((p) => (
          <article class="case">
            <img src={p.img} alt={`${p.title} storefront`} loading="lazy" />
            <div class="case-body">
              <p class="tag">{p.tag}</p>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <a href={p.url}>Visit site</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="grey">
      <div class="wrap section">
        <h2>Learn with me, one post a day</h2>
        <p class="sub">Two 60-post series for complete beginners.</p>
        <div class="series">
          {seriesCards.map((c) => <a class="series-card" href={c.href}><span class="when">{c.name} · latest</span><span class="series-title">{c.text}</span></a>)}
        </div>
      </div>
    </section>

    <section id="services" class="blue">
      <div class="wrap section-lg">
        <p class="eyebrow">Also: freelance</p>
        <div class="services-head">
          <h2>Need a hand with your site?</h2>
          <p>I take on a small number of WordPress and WooCommerce projects. You deal with one person from first call to handover.</p>
        </div>
        <div class="rows rows-blue">
          {services.map(([title, text], i) => <div class="row"><span class="idx">0{i + 1}</span><h3>{title}</h3><p>{text}</p></div>)}
        </div>
        <div class="services-foot">
          <p><strong>How it works: </strong>a short call, then a written scope and quote, then the work with a note on what changed and why.</p>
          <a class="btn btn-gold" href="#contact">Get in touch</a>
        </div>
      </div>
    </section>

    <section id="contact" class="dark">
      <div class="wrap section-lg">
        <h2 class="talk">Let's talk.</h2>
        <div class="doors">
          <div class="door door-main">
            <p class="eyebrow">Hiring for a role</p>
            <h3>Technical Support Lead</h3>
            <p>Email is the fastest way to reach me: <a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <div class="actions">
              <a class="btn btn-white" href={RESUME}>Download resume</a>
              <button type="button" class="btn btn-line-white" data-copy={EMAIL}>Copy email</button>
            </div>
          </div>
          <div class="door">
            <p class="eyebrow">Have a project</p>
            <h3>A site to build, fix or look after</h3>
            <p>Tell me what's going on and I'll reply with next steps: <a class="mail" href={projectMail}>{EMAIL}</a></p>
            <div class="actions">
              <button type="button" class="btn btn-gold" data-copy={EMAIL}>Copy email</button>
            </div>
          </div>
        </div>
        <footer class="foot">
          <span>{NAME} · {LOCATION}</span>
          <div><a href={LINKEDIN}>LinkedIn</a><a href={GITHUB}>GitHub</a></div>
        </footer>
      </div>
    </section>

    <p class="sr-only" aria-live="polite" id="copy-status"></p>
    <script>
      // Copy-email buttons: mailto links do nothing for people without a desktop mail app.
      const status = document.getElementById("copy-status");
      document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((btn) => {
        const label = btn.textContent;
        btn.addEventListener("click", async () => {
          const text = btn.dataset.copy ?? "";
          let ok = false;
          try {
            await navigator.clipboard.writeText(text);
            ok = true;
          } catch {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try { ok = document.execCommand("copy"); } catch { ok = false; }
            ta.remove();
          }
          btn.textContent = ok ? "Copied" : "Select the address above";
          if (status) status.textContent = ok ? "Email address copied" : "Could not copy the email address";
          setTimeout(() => { btn.textContent = label; if (status) status.textContent = ""; }, 2200);
        });
      });
    </script>
    <script>
      import { inject } from "@vercel/analytics";
      inject({ framework: "astro" });
    </script>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: #fff; color: #101418; font-family: "Inter", system-ui, sans-serif; overflow-wrap: break-word; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3, .brand, .num, .idx, .series-title { font-family: "Space Grotesk", system-ui, sans-serif; }
  img { display: block; max-width: 100%; }
  a { color: #2340d6; }
  a:hover { color: #16298f; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .wrap { max-width: 1200px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .section { padding-top: 80px; padding-bottom: 80px; }
  .section-lg { padding-top: 88px; padding-bottom: 88px; }
  .tight-top { padding-top: 0; }
  .grey { background: #f4f5f7; }
  h2 { font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em; }
  .sub { margin-top: 14px; font-size: 18px; line-height: 1.6; color: #414b57; }

  .nav { max-width: 1200px; margin: 0 auto; padding: 20px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; font-size: 15px; font-weight: 500; }
  .brand { font-size: 20px; font-weight: 700; color: #101418; text-decoration: none; }
  .brand span { color: #2340d6; }
  .nav-links { display: flex; flex-wrap: wrap; gap: 4px 28px; align-items: center; }
  .nav a { min-height: 44px; display: inline-flex; align-items: center; }
  .nav-links a { color: #101418; text-decoration: none; }
  .nav-links a:hover { color: #2340d6; }
  .nav-links .pill-dark { padding: 0 20px; border-radius: 999px; background: #101418; color: #fff; font-weight: 600; }
  .nav-links .pill-dark:hover { background: #2340d6; color: #fff; }

  .hero { padding-top: 72px; padding-bottom: 56px; }
  .status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px; border-radius: 18px; background: #eef1ff; color: #16298f; font-size: 15px; font-weight: 500; line-height: 1.4; margin-bottom: 28px; }
  .status span { flex: 0 0 8px; width: 8px; height: 8px; border-radius: 50%; background: #2340d6; }
  h1 { font-size: clamp(40px, 6.6vw, 88px); line-height: 1.08; letter-spacing: -0.035em; font-weight: 700; max-width: 1080px; }
  /* Marker-style highlight on the lower half only, so it never covers the line above. */
  .mark { background-image: linear-gradient(to top, transparent 8%, #ffc53d 8%, #ffc53d 46%, transparent 46%); -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .hero-row { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-end; justify-content: space-between; }
  .lead { flex: 1 1 460px; min-width: 0; max-width: 620px; font-size: 20px; line-height: 1.6; color: #414b57; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .aside { margin-top: 24px; font-size: 15px; color: #414b57; }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; font-weight: 600; text-decoration: none; border: 1.5px solid transparent; }
  .btn-blue { background: #2340d6; color: #fff; }
  .btn-blue:hover { background: #16298f; color: #fff; }
  .btn-line { border-color: #101418; color: #101418; }
  .btn-line:hover { background: #101418; color: #fff; }
  .btn-gold { background: #ffc53d; color: #101418; }
  .btn-gold:hover { background: #fff; color: #101418; }
  .btn-white { background: #fff; color: #101418; }
  .btn-white:hover { background: #ffc53d; color: #101418; }
  .btn-line-white { border-color: #fff; color: #fff; }
  .btn-line-white:hover { background: #fff; color: #101418; }

  .stats { border-top: 2px solid #101418; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0 24px; padding-bottom: 80px; }
  .stats > div { padding-top: 28px; }
  .num { font-size: clamp(44px, 5vw, 64px); line-height: 1; font-weight: 700; letter-spacing: -0.03em; }
  .num-label { margin-top: 10px; color: #414b57; }

  .split { display: flex; flex-wrap: wrap; gap: 40px 64px; }
  .split-head { flex: 1 1 300px; min-width: 0; }
  .rows { flex: 2 1 520px; min-width: 0; border-bottom: 1px solid #c9ced6; }
  .row { display: flex; flex-wrap: wrap; gap: 6px 32px; padding: 22px 0; border-top: 1px solid #c9ced6; align-items: baseline; }
  .row h3 { flex: 1 1 240px; min-width: 0; font-size: 22px; }
  .row p { flex: 1.4 1 280px; min-width: 0; line-height: 1.6; color: #414b57; }

  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 12px; align-items: baseline; margin-bottom: 32px; }
  .section-head a { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .cases { display: flex; flex-direction: column; gap: 32px; }
  .case { display: flex; flex-wrap: wrap; border: 1.5px solid #101418; border-radius: 20px; overflow: hidden; }
  .case:nth-child(even) { flex-direction: row-reverse; }
  .case img { flex: 1 1 420px; min-width: 0; width: 100%; height: auto; min-height: 300px; max-height: 420px; object-fit: cover; object-position: top; }
  .case-body { flex: 1 1 420px; min-width: 0; padding: 36px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; justify-content: center; }
  .case-body h3 { font-size: 32px; letter-spacing: -0.01em; }
  .case-body p { line-height: 1.6; color: #414b57; }
  .case-body a { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .case-body .tag { padding: 6px 12px; border-radius: 999px; background: #eef1ff; color: #16298f; font-size: 14px; font-weight: 500; }

  .roles { border-bottom: 1px solid #c9ced6; }
  .role { display: flex; flex-wrap: wrap; gap: 6px 32px; padding: 22px 0; border-top: 1px solid #c9ced6; align-items: baseline; }
  .when { font-size: 14px; font-weight: 600; color: #16298f; }
  .role .when { flex: 0 0 180px; }
  .role h3 { flex: 1 1 260px; min-width: 0; font-size: 21px; }
  .role p:last-child { flex: 2 1 380px; min-width: 0; line-height: 1.6; color: #414b57; }

  .series { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px; }
  .series-card { display: block; padding: 28px; background: #fff; border: 1.5px solid #101418; border-radius: 20px; color: #101418; text-decoration: none; }
  .series-card:hover { border-color: #2340d6; color: #101418; }
  .series-card span { display: block; }
  .series-title { margin-top: 10px; font-size: 24px; font-weight: 600; line-height: 1.25; }

  .blue { background: #2340d6; color: #fff; }
  .eyebrow { font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #ffc53d; }
  .services-head { margin: 16px 0 44px; display: flex; flex-wrap: wrap; gap: 20px 64px; align-items: flex-end; justify-content: space-between; }
  .services-head h2 { flex: 1 1 480px; min-width: 0; font-size: clamp(36px, 5vw, 60px); line-height: 1.02; letter-spacing: -0.025em; }
  .services-head p { flex: 1 1 360px; min-width: 0; max-width: 460px; font-size: 18px; line-height: 1.6; color: #e3e8ff; }
  .rows-blue { border-bottom-color: #7f93f0; }
  .rows-blue .row { border-top-color: #7f93f0; padding: 26px 0; }
  .rows-blue .idx { flex: 0 0 56px; font-size: 20px; color: #ffc53d; }
  .rows-blue h3 { flex: 1 1 280px; font-size: 28px; }
  .rows-blue p { flex: 1.4 1 340px; font-size: 17px; color: #e3e8ff; }
  .services-foot { margin-top: 44px; display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: center; justify-content: space-between; }
  .services-foot p { flex: 1 1 480px; min-width: 0; font-size: 17px; line-height: 1.6; color: #e3e8ff; }
  .services-foot strong { color: #fff; }

  .dark { background: #101418; color: #fff; }
  .talk { font-size: clamp(40px, 6vw, 76px); line-height: 1; letter-spacing: -0.03em; margin-bottom: 44px; }
  .doors { display: flex; flex-wrap: wrap; gap: 24px; }
  .door { flex: 1 1 320px; min-width: 0; background: #1c222b; border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .door-main { flex: 1.7 1 420px; }
  .door h3 { font-size: 26px; line-height: 1.2; }
  .door > p:not(.eyebrow) { line-height: 1.6; color: #c8ced8; }
  .door .actions { margin-top: 8px; }
  .door .mail { color: #fff; font-weight: 600; white-space: nowrap; }
  .door .mail:hover { color: #ffc53d; }
  button.btn { font: inherit; font-weight: 600; cursor: pointer; background: none; }
  button.btn.btn-gold { background: #ffc53d; }
  button.btn.btn-gold:hover, button.btn.btn-line-white:hover { background: #fff; color: #101418; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .foot { margin-top: 56px; padding-top: 24px; border-top: 1px solid #3a424e; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; font-size: 14px; color: #c8ced8; }
  .foot div { display: flex; gap: 24px; }
  .foot a { color: #fff; min-height: 44px; display: inline-flex; align-items: center; }

  @media (max-width: 600px) {
    .wrap, .nav { padding-left: 20px; padding-right: 20px; }
    .hero { padding-top: 40px; }
    .section { padding-top: 56px; padding-bottom: 56px; }
    .tight-top { padding-top: 0; }
    .case-body { padding: 24px; }
    .nav-links { gap: 4px 18px; }
  }
</style>
